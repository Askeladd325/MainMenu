[sub_resource type="GDScript" id="GDScript_1wnlg"]
script/source = "extends VBoxContainer # Dahil naka-attach ito sa VBoxContainer

func _ready() -> void:
	# 1. Hahanapin natin ang lahat ng children ng container na ito
	for child in get_children():
		# 2. Tinitiyak natin na ang child ay isang uri ng BaseButton (gaya ng TextureButton)
		if child is BaseButton:
			# 3. I-set ang Pivot Point ng button sa gitna
			# Ito ay mahalaga para sa maayos na scaling animation
			child.pivot_offset = child.size / 2
			
			# 4. I-connect ang mga signals gamit ang code
			# Hindi na natin kailangang i-connect sa Node tab isa-isa
			child.button_down.connect(_on_button_down.bind(child))
			child.button_up.connect(_on_button_up.bind(child))
			# I-update ang pivot kapag nagbago ang size ng button
			child.resized.connect(_on_button_resized.bind(child))

func _on_button_resized(button: BaseButton) -> void:
	# I-update ang pivot point sa gitna kapag nag-resize
	button.pivot_offset = button.size / 2

# FUNCTION 1: Kapag PININDOT ang button (Button Down)
func _on_button_down(button: BaseButton) -> void:
	# Gumawa ng bagong Tween para sa parallel na animations
	var tween = create_tween().set_parallel(true)
	
	# A. Paliitin nang kaunti ang button (Scale)
	# Vector2(0.9, 0.9) ay 90% ng orihinal na laki
	tween.tween_property(button, \"scale\", Vector2(0.9, 0.9), 0.1).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	
	# B. Ibaba nang kaunti ang button (Position)
	# Nagdadagdag tayo ng 5 pixels sa Y position
	tween.tween_property(button, \"position:y\", button.position.y + 5, 0.1)

# FUNCTION 2: Kapag BINITAWAN ang button (Button Up)
func _on_button_up(button: BaseButton) -> void:
	# Gumawa ng bagong Tween para sa parallel na animations
	var tween = create_tween().set_parallel(true)
	
	# A. Ibalik sa orihinal na laki (Scale 1.0) na may TALBOG (TRANS_BOUNCE)
	# Ito ang nagbibigay ng \"juicy\" feel
	tween.tween_property(button, \"scale\", Vector2(1.0, 1.0), 0.3).set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
	
	# B. Ibalik sa orihinal na posisyon (bawasan ang 5 pixels)
	tween.tween_property(button, \"position:y\", button.position.y - 5, 0.1)
"

